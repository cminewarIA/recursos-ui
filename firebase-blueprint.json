{
  "entities": {
    "UserWorkspace": {
      "title": "UserWorkspace",
      "description": "Root multi-device synchronization workspace owned by an authenticated user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the workspace owner."
        },
        "displayName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100,
          "description": "User display name shown in the dashboard cloud status card."
        },
        "lastHostname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Most recent host machine hostname synchronized to this workspace."
        },
        "appVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Canonical application version string read from VERSION."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the workspace was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the latest workspace update."
        }
      },
      "required": ["uid", "displayName", "lastHostname", "appVersion", "createdAt", "updatedAt"]
    },
    "UserPrivateAccount": {
      "title": "UserPrivateAccount",
      "description": "Isolated PII document holding authenticated user email metadata.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "emailVerified": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "emailVerified", "createdAt", "updatedAt"]
    },
    "CockpitPreferences": {
      "title": "CockpitPreferences",
      "description": "Real-time cross-device synchronized theme, language locale, and sync settings.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "theme": {
          "type": "string",
          "enum": ["light", "dark"],
          "minLength": 4,
          "maxLength": 8
        },
        "locale": {
          "type": "string",
          "minLength": 2,
          "maxLength": 10,
          "pattern": "^[a-z]{2}(-[A-Za-z0-9]{2,8})?$"
        },
        "autoSync": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "theme", "locale", "autoSync", "createdAt", "updatedAt"]
    },
    "SyncedSpeedTestRecord": {
      "title": "SyncedSpeedTestRecord",
      "description": "Speedtest.net measurement synchronized across devices via Cloud Firestore.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "testId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "downloadMbps": {
          "type": "number"
        },
        "uploadMbps": {
          "type": "number"
        },
        "pingMs": {
          "type": "number"
        },
        "jitterMs": {
          "type": "number"
        },
        "packetLossPct": {
          "type": "number"
        },
        "serverName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160
        },
        "serverLocation": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160
        },
        "isp": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "hostname": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "testId",
        "downloadMbps",
        "uploadMbps",
        "pingMs",
        "jitterMs",
        "packetLossPct",
        "serverName",
        "serverLocation",
        "isp",
        "hostname",
        "createdAt",
        "updatedAt"
      ]
    },
    "SyncedHostSnapshot": {
      "title": "SyncedHostSnapshot",
      "description": "Real-time telemetry summary snapshot pushed by monitored host nodes.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "nodeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "hostname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "appVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "cpuPercent": {
          "type": "number"
        },
        "ramPercent": {
          "type": "number"
        },
        "gpuPercent": {
          "type": "number"
        },
        "wanRxBps": {
          "type": "number"
        },
        "wanTxBps": {
          "type": "number"
        },
        "onlineDevices": {
          "type": "number"
        },
        "healthStatus": {
          "type": "string",
          "enum": ["healthy", "busy", "reconnecting"],
          "minLength": 4,
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "nodeId",
        "hostname",
        "appVersion",
        "cpuPercent",
        "ramPercent",
        "gpuPercent",
        "wanRxBps",
        "wanTxBps",
        "onlineDevices",
        "healthStatus",
        "createdAt",
        "updatedAt"
      ]
    },
    "SyncedPingSample": {
      "title": "SyncedPingSample",
      "description": "Persisted network ping latency history snapshot synchronized across devices via Cloud Firestore.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sampleId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "hostname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "targetIp": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "targetLabel": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "kind": {
          "type": "string",
          "enum": ["gateway", "external", "dns"],
          "minLength": 3,
          "maxLength": 16
        },
        "avgMs": {
          "type": "number"
        },
        "minMs": {
          "type": "number"
        },
        "maxMs": {
          "type": "number"
        },
        "lastMs": {
          "type": "number"
        },
        "jitterMs": {
          "type": "number"
        },
        "lossPct": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "sampleId",
        "hostname",
        "targetId",
        "targetIp",
        "targetLabel",
        "kind",
        "avgMs",
        "minMs",
        "maxMs",
        "lastMs",
        "jitterMs",
        "lossPct",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserWorkspace" },
      "description": "Root owner workspace document storing non-PII profile metadata and active host summary."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateAccount" },
      "description": "Isolated PII subcollection storing owner email and verification state."
    },
    "/users/{userId}/preferences/{prefId}": {
      "schema": { "$ref": "#/entities/CockpitPreferences" },
      "description": "Real-time cross-device user UI preferences (theme, language locale, autoSync)."
    },
    "/users/{userId}/speedtests/{speedtestId}": {
      "schema": { "$ref": "#/entities/SyncedSpeedTestRecord" },
      "description": "Cloud-synchronized Speedtest.net benchmark history records."
    },
    "/users/{userId}/nodes/{nodeId}": {
      "schema": { "$ref": "#/entities/SyncedHostSnapshot" },
      "description": "Real-time synchronized host node health and throughput snapshots."
    },
    "/users/{userId}/pingHistory/{sampleId}": {
      "schema": { "$ref": "#/entities/SyncedPingSample" },
      "description": "Persisted network ping latency samples for multi-device historical inspection."
    }
  }
}
