#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    # Ocultar lanzadores auxiliares de dependencias CLI/backend para no saturar el box de aplicaciones
    for extra_desktop in /usr/share/applications/scrcpy.desktop /usr/share/applications/scrcpy-console.desktop; do
        if [ -f "$extra_desktop" ]; then
            grep -v "^NoDisplay=" "$extra_desktop" > "${extra_desktop}.tmp" 2>/dev/null || cp "$extra_desktop" "${extra_desktop}.tmp"
            awk '/^\[Desktop Entry\]/{print; print "NoDisplay=true"; next}1' "${extra_desktop}.tmp" > "$extra_desktop"
            rm -f "${extra_desktop}.tmp"
        fi
    done

    # Registrar clave pública de firma para futuras actualizaciones locales/APT sin advertencias
    if [ -f /usr/share/keyrings/recursos-cockpit-archive-keyring.gpg ] && [ -d /etc/apt/trusted.gpg.d ]; then
        cp -f /usr/share/keyrings/recursos-cockpit-archive-keyring.gpg /etc/apt/trusted.gpg.d/recursos-cockpit-archive-keyring.gpg 2>/dev/null || true
        chmod 644 /etc/apt/trusted.gpg.d/recursos-cockpit-archive-keyring.gpg 2>/dev/null || true
    fi

    # Actualizar bases de datos de escritorio e iconos
    if which gtk-update-icon-cache >/dev/null 2>&1; then
        gtk-update-icon-cache -f -t /usr/share/icons/hicolor || true
    fi
    if which update-desktop-database >/dev/null 2>&1; then
        update-desktop-database -q /usr/share/applications || true
    fi

    # Purgar viejos lanzadores PWA residuales en perfiles de usuario
    for u_home in /home/*; do
        if [ -d "$u_home/.local/share/applications" ]; then
            rm -f "$u_home/.local/share/applications/cminewar-recursos.desktop" 2>/dev/null || true
            rm -f "$u_home/.local/share/applications/scrcpy.desktop" 2>/dev/null || true
            rm -f "$u_home/.local/share/applications/scrcpy-console.desktop" 2>/dev/null || true
        fi
    done

    # Inicializar recursos_history.db al instalar sin sobrescribir jamás datos existentes en actualizaciones
    SVC_WORKDIR=""
    if command -v systemctl >/dev/null 2>&1; then
        SVC_WORKDIR="$(systemctl show -p WorkingDirectory --value system-dashboard.service 2>/dev/null || true)"
    fi
    if [ -n "$SVC_WORKDIR" ] && [ -d "$SVC_WORKDIR" ]; then
        TARGET_DB_DIR="$SVC_WORKDIR"
    else
        TARGET_DB_DIR="/var/lib/recursos-cockpit"
        mkdir -p "$TARGET_DB_DIR" 2>/dev/null || true
    fi

    if [ -d "$TARGET_DB_DIR" ] && command -v python3 >/dev/null 2>&1; then
        python3 - "$TARGET_DB_DIR" <<'PYEOF' || true
import os, sqlite3, sys

db_dir = sys.argv[1]
db_path = os.path.join(db_dir, "recursos_history.db")
legacy_path = os.path.join(db_dir, "geoip_history.db")

if not os.path.exists(db_path) and os.path.exists(legacy_path):
    for suf in ("", "-wal", "-shm"):
        s = legacy_path + suf
        d = db_path + suf
        if os.path.exists(s) and not os.path.exists(d):
            try:
                os.replace(s, d)
            except Exception:
                pass

db_exists = os.path.exists(db_path)
if db_exists:
    try:
        ro_conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True, timeout=5.0)
        tables = {r[0] for r in ro_conn.execute("SELECT name FROM sqlite_master WHERE type='table'").fetchall()}
        ro_conn.close()
        if {"geoip_locations", "connection_history", "telemetry_history", "ping_history", "process_history", "ai_connection_insights", "ai_system_fault_insights", "speedtest_history"}.issubset(tables):
            sys.exit(0)
    except Exception:
        pass

conn = sqlite3.connect(db_path, timeout=10.0)
conn.execute("PRAGMA journal_mode=WAL;")
conn.execute("PRAGMA synchronous=NORMAL;")
conn.execute("""
    CREATE TABLE IF NOT EXISTS geoip_locations (
        ip TEXT PRIMARY KEY, lat REAL NOT NULL, lng REAL NOT NULL,
        city TEXT DEFAULT '', region TEXT DEFAULT '', postal TEXT DEFAULT '',
        country TEXT DEFAULT '', country_code TEXT DEFAULT '', isp TEXT DEFAULT '',
        asn TEXT DEFAULT '', accuracy_source TEXT DEFAULT 'ip-api', updated_at REAL NOT NULL
    )
""")
conn.execute("""
    CREATE TABLE IF NOT EXISTS connection_history (
        id INTEGER PRIMARY KEY AUTOINCREMENT, conn_key TEXT UNIQUE NOT NULL,
        direction TEXT NOT NULL, protocol TEXT DEFAULT 'TCP', local_ip TEXT DEFAULT '',
        local_hostname TEXT DEFAULT '', local_port INTEGER DEFAULT 0, remote_ip TEXT NOT NULL,
        remote_port INTEGER DEFAULT 0, domain TEXT DEFAULT '', service TEXT NOT NULL,
        process TEXT DEFAULT '', jail TEXT DEFAULT '', lat REAL NOT NULL, lng REAL NOT NULL,
        city TEXT DEFAULT '', region TEXT DEFAULT '', postal TEXT DEFAULT '',
        country TEXT DEFAULT '', country_code TEXT DEFAULT '', isp TEXT DEFAULT '',
        asn TEXT DEFAULT '', accuracy_source TEXT DEFAULT 'ip-api',
        first_seen REAL NOT NULL, last_seen REAL NOT NULL, hit_count INTEGER DEFAULT 1
    )
""")
conn.execute("""
    CREATE TABLE IF NOT EXISTS telemetry_history (
        ts REAL PRIMARY KEY, time_str TEXT NOT NULL,
        cpu REAL DEFAULT 0, cpu_temp REAL DEFAULT 0, cpu_freq REAL DEFAULT 0,
        cpu_power REAL DEFAULT 0, cpu_load_1m REAL DEFAULT 0, cpu_load_5m REAL DEFAULT 0,
        cpu_user REAL DEFAULT 0, cpu_system REAL DEFAULT 0, cpu_iowait REAL DEFAULT 0,
        gpu REAL DEFAULT 0, gpu_vram_pct REAL DEFAULT 0, gpu_mem_ctrl REAL DEFAULT 0,
        gpu_enc REAL DEFAULT 0, gpu_dec REAL DEFAULT 0, gpu_power REAL DEFAULT 0,
        gpu_temp REAL DEFAULT 0, gpu_clk_gfx REAL DEFAULT 0, gpu_clk_mem REAL DEFAULT 0,
        gpu_pcie_rx REAL DEFAULT 0, gpu_pcie_tx REAL DEFAULT 0,
        ram REAL DEFAULT 0, ram_total REAL DEFAULT 0,
        net_rx REAL DEFAULT 0, net_tx REAL DEFAULT 0,
        net_wan_rx REAL DEFAULT 0, net_wan_tx REAL DEFAULT 0,
        net_lan_rx REAL DEFAULT 0, net_lan_tx REAL DEFAULT 0,
        disk_r REAL DEFAULT 0, disk_w REAL DEFAULT 0, disk_pct REAL DEFAULT 0
    )
""")
conn.execute("CREATE INDEX IF NOT EXISTS idx_telemetry_history_ts ON telemetry_history(ts DESC);")
conn.execute("""
    CREATE TABLE IF NOT EXISTS ping_history (
        ts REAL NOT NULL, target_id TEXT NOT NULL, target_ip TEXT NOT NULL,
        label TEXT DEFAULT '', kind TEXT DEFAULT 'external',
        rtt_ms REAL DEFAULT -1, loss_pct REAL DEFAULT 0,
        PRIMARY KEY (ts, target_id)
    )
""")
conn.execute("CREATE INDEX IF NOT EXISTS idx_ping_history_ts ON ping_history(ts DESC);")
conn.execute("""
    CREATE TABLE IF NOT EXISTS process_history (
        ts REAL NOT NULL, proc_name TEXT NOT NULL,
        cpu_pct REAL DEFAULT 0, ram_mb REAL DEFAULT 0,
        vram_mb REAL DEFAULT 0, io_bps REAL DEFAULT 0,
        PRIMARY KEY (ts, proc_name)
    )
""")
conn.execute("CREATE INDEX IF NOT EXISTS idx_process_history_ts ON process_history(ts DESC);")
conn.execute("""
    CREATE TABLE IF NOT EXISTS ai_connection_insights (
        lang TEXT NOT NULL, signature TEXT NOT NULL,
        app_name TEXT NOT NULL, category TEXT DEFAULT '',
        role TEXT DEFAULT '', summary TEXT DEFAULT '',
        confidence TEXT DEFAULT 'medium', model TEXT DEFAULT '',
        analyzed_at REAL NOT NULL,
        PRIMARY KEY (lang, signature)
    )
""")
conn.execute("CREATE INDEX IF NOT EXISTS idx_ai_conn_analyzed_at ON ai_connection_insights(analyzed_at DESC);")
conn.execute("""
    CREATE TABLE IF NOT EXISTS ai_system_fault_insights (
        lang TEXT NOT NULL, signature TEXT NOT NULL,
        unit TEXT DEFAULT '', category TEXT DEFAULT '',
        title TEXT NOT NULL, danger_level TEXT DEFAULT 'medium',
        summary TEXT DEFAULT '', solution TEXT DEFAULT '',
        confidence TEXT DEFAULT 'medium', model TEXT DEFAULT '',
        occurrence_count INTEGER DEFAULT 1,
        first_seen_at REAL NOT NULL, analyzed_at REAL NOT NULL,
        PRIMARY KEY (lang, signature)
    )
""")
conn.execute("CREATE INDEX IF NOT EXISTS idx_ai_fault_analyzed_at ON ai_system_fault_insights(analyzed_at DESC);")
conn.execute("""
    CREATE TABLE IF NOT EXISTS speedtest_history (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        ts REAL NOT NULL, created_at TEXT NOT NULL,
        download_mbps REAL NOT NULL, upload_mbps REAL NOT NULL,
        ping_ms REAL DEFAULT 0, jitter_ms REAL DEFAULT 0, packet_loss_pct REAL DEFAULT 0,
        server_name TEXT DEFAULT '', server_host TEXT DEFAULT '',
        server_location TEXT DEFAULT '', client_ip TEXT DEFAULT '',
        isp TEXT DEFAULT '', duration_ms INTEGER DEFAULT 0, scope TEXT DEFAULT 'wan'
    )
""")
conn.execute("CREATE INDEX IF NOT EXISTS idx_speedtest_history_ts ON speedtest_history(ts DESC);")
conn.commit()
conn.close()

try:
    st = os.stat(db_dir)
    for suf in ("", "-wal", "-shm"):
        p = db_path + suf
        if os.path.exists(p):
            os.chown(p, st.st_uid, st.st_gid)
except Exception:
    pass
PYEOF
    fi

    # Registrar servicio mDNS/Avahi (_recursos._tcp) para autodescubrimiento LAN instantáneo
    if [ -d /etc/avahi/services ]; then
        cat <<'AVAHIEOF' > /etc/avahi/services/recursos-cockpit.service
<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<service-group>
  <name replace-wildcards="yes">%h</name>
  <service protocol="ipv4">
    <type>_recursos._tcp</type>
    <port>8085</port>
    <txt-record>path=/</txt-record>
    <txt-record>app=recursos-cockpit</txt-record>
  </service>
</service-group>
AVAHIEOF
        chmod 644 /etc/avahi/services/recursos-cockpit.service 2>/dev/null || true
    fi
fi

exit 0
