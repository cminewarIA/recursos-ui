rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasParentWorkspace(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    // Validation Blueprints (called on both create and update; no existing()/diff() inside)
    function isValidUserWorkspace(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'lastHostname', 'appVersion', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'lastHostname', 'appVersion', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.displayName is string && data.displayName.size() <= 100
        && data.lastHostname is string && data.lastHostname.size() >= 1 && data.lastHostname.size() <= 120
        && data.appVersion is string && data.appVersion.size() >= 1 && data.appVersion.size() <= 32
        && data.appVersion.matches('^[0-9]+\\.[0-9]+\\.[0-9]+$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidUserPrivateAccount(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'emailVerified', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'emailVerified', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.emailVerified is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidCockpitPreferences(data, userId) {
      return data.keys().hasAll(['uid', 'theme', 'locale', 'autoSync', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'theme', 'locale', 'autoSync', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.theme is string && data.theme in ['light', 'dark']
        && data.locale is string && data.locale.size() >= 2 && data.locale.size() <= 10
        && data.locale.matches('^[a-z]{2}(-[A-Za-z0-9]{2,8})?$')
        && data.autoSync is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidSpeedTestRecord(data, userId, speedtestId) {
      return data.keys().hasAll([
          'uid', 'testId', 'downloadMbps', 'uploadMbps', 'pingMs', 'jitterMs',
          'packetLossPct', 'serverName', 'serverLocation', 'isp', 'hostname', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'testId', 'downloadMbps', 'uploadMbps', 'pingMs', 'jitterMs',
          'packetLossPct', 'serverName', 'serverLocation', 'isp', 'hostname', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && isValidId(data.testId)
        && data.testId == speedtestId
        && data.downloadMbps is number && data.downloadMbps >= 0 && data.downloadMbps <= 1000000
        && data.uploadMbps is number && data.uploadMbps >= 0 && data.uploadMbps <= 1000000
        && data.pingMs is number && data.pingMs >= 0 && data.pingMs <= 60000
        && data.jitterMs is number && data.jitterMs >= 0 && data.jitterMs <= 60000
        && data.packetLossPct is number && data.packetLossPct >= 0 && data.packetLossPct <= 100
        && data.serverName is string && data.serverName.size() <= 160
        && data.serverLocation is string && data.serverLocation.size() <= 160
        && data.isp is string && data.isp.size() <= 120
        && data.hostname is string && data.hostname.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidHostSnapshot(data, userId, nodeId) {
      return data.keys().hasAll([
          'uid', 'nodeId', 'hostname', 'appVersion', 'cpuPercent', 'ramPercent',
          'gpuPercent', 'wanRxBps', 'wanTxBps', 'onlineDevices', 'healthStatus', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'nodeId', 'hostname', 'appVersion', 'cpuPercent', 'ramPercent',
          'gpuPercent', 'wanRxBps', 'wanTxBps', 'onlineDevices', 'healthStatus', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && isValidId(data.nodeId)
        && data.nodeId == nodeId
        && data.hostname is string && data.hostname.size() >= 1 && data.hostname.size() <= 120
        && data.appVersion is string && data.appVersion.size() >= 1 && data.appVersion.size() <= 32
        && data.appVersion.matches('^[0-9]+\\.[0-9]+\\.[0-9]+$')
        && data.cpuPercent is number && data.cpuPercent >= 0 && data.cpuPercent <= 100
        && data.ramPercent is number && data.ramPercent >= 0 && data.ramPercent <= 100
        && data.gpuPercent is number && data.gpuPercent >= 0 && data.gpuPercent <= 100
        && data.wanRxBps is number && data.wanRxBps >= 0 && data.wanRxBps <= 1000000000000
        && data.wanTxBps is number && data.wanTxBps >= 0 && data.wanTxBps <= 1000000000000
        && data.onlineDevices is number && data.onlineDevices >= 0 && data.onlineDevices <= 100000
        && data.healthStatus is string && data.healthStatus in ['healthy', 'busy', 'reconnecting']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    // 1. Root User Workspace (Non-PII)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if isOwner(userId) && existing().uid == request.auth.uid;
      allow create: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidUserWorkspace(incoming(), userId)
        && incoming().createdAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidUserWorkspace(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'lastHostname', 'appVersion', 'updatedAt']);
      allow delete: if isValidId(userId) && isOwner(userId);

      // 2. Isolated PII Subcollection (email strictly restricted to owner)
      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().uid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(docId)
          && docId == 'account'
          && isVerifiedUser()
          && isOwner(userId)
          && isValidUserPrivateAccount(incoming(), userId)
          && incoming().createdAt == request.time
          && hasParentWorkspace(userId);
        allow update: if isValidId(userId)
          && isValidId(docId)
          && docId == 'account'
          && isVerifiedUser()
          && isOwner(userId)
          && isValidUserPrivateAccount(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'emailVerified', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(docId) && isOwner(userId);
      }

      // 3. Real-Time Synced Cockpit Preferences
      match /preferences/{prefId} {
        allow get: if isValidId(userId) && isValidId(prefId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().uid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(prefId)
          && prefId == 'cockpit'
          && isVerifiedUser()
          && isOwner(userId)
          && isValidCockpitPreferences(incoming(), userId)
          && incoming().createdAt == request.time
          && hasParentWorkspace(userId);
        allow update: if isValidId(userId)
          && isValidId(prefId)
          && prefId == 'cockpit'
          && isVerifiedUser()
          && isOwner(userId)
          && isValidCockpitPreferences(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['theme', 'locale', 'autoSync', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(prefId) && isOwner(userId);
      }

      // 4. Cloud-Synced Speedtest History
      match /speedtests/{speedtestId} {
        allow get: if isValidId(userId) && isValidId(speedtestId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().uid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(speedtestId)
          && isVerifiedUser()
          && isOwner(userId)
          && isValidSpeedTestRecord(incoming(), userId, speedtestId)
          && incoming().createdAt == request.time
          && hasParentWorkspace(userId);
        allow update: if isValidId(userId)
          && isValidId(speedtestId)
          && isVerifiedUser()
          && isOwner(userId)
          && isValidSpeedTestRecord(incoming(), userId, speedtestId)
          && incoming().uid == existing().uid
          && incoming().testId == existing().testId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'downloadMbps', 'uploadMbps', 'pingMs', 'jitterMs', 'packetLossPct',
            'serverName', 'serverLocation', 'isp', 'hostname', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(speedtestId) && isOwner(userId);
      }

      // 5. Real-Time Synced Host Snapshots
      match /nodes/{nodeId} {
        allow get: if isValidId(userId) && isValidId(nodeId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().uid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(nodeId)
          && isVerifiedUser()
          && isOwner(userId)
          && isValidHostSnapshot(incoming(), userId, nodeId)
          && incoming().createdAt == request.time
          && hasParentWorkspace(userId);
        allow update: if isValidId(userId)
          && isValidId(nodeId)
          && isVerifiedUser()
          && isOwner(userId)
          && isValidHostSnapshot(incoming(), userId, nodeId)
          && incoming().uid == existing().uid
          && incoming().nodeId == existing().nodeId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'hostname', 'appVersion', 'cpuPercent', 'ramPercent', 'gpuPercent',
            'wanRxBps', 'wanTxBps', 'onlineDevices', 'healthStatus', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(nodeId) && isOwner(userId);
      }
    }
  }
}
